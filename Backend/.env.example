DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/parkandgo
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/parkandgo_test
SECRET_KEY=your-secret-key-here-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
REDIS_URL=redis://localhost:6379
# Set to "false" to disable Redis entirely (no connection attempted, _NullRedis used instead)
USE_REDIS=false
RENDER_DEPLOY_HOOK_URL=your-render-secret-hook-url
ALLOWED_ORIGINS=http://localhost:3000,https://parkango.netlify.app

ADMIN_EMAILS=your-admin-email@example.com

# Set to "production" and DEBUG=false on Render
ENVIRONMENT=development
DEBUG=true

